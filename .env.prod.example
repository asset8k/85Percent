# ============================================================================
# 85Percent — PRODUCTION environment template
# ----------------------------------------------------------------------------
# These are the keys for the PROD Supabase project:
#     Project ref : fkyexcddvogkngbbrefz
#     URL         : https://fkyexcddvogkngbbrefz.supabase.co
#     Region      : (set from the Supabase dashboard for this project)
#
# Same structure as .env.dev.example — each app reads its OWN env file with its
# OWN prefix. This is the consolidated PROD reference. In production these
# values are NOT kept in local files: set them in the hosting platform —
#   • Next.js apps (admin, landing) → Vercel → Project → Settings → Environment
#     Variables, scoped to the "Production" environment.
# The admin Vercel project owns both admin-panel and API server secrets.
#
# Put PROD keys here / in the prod hosting env. DEV keys go in .env.dev.example.
# A real-value copy of this file must NEVER be committed — only this blank
# *.example is tracked. Generate FRESH secrets for prod (do not reuse dev's
# ADMIN_PASSWORD / ADMIN_SESSION_SECRET / Upstash db).
# ============================================================================


# ── apps/admin  (Next.js admin + API — Vercel Production env) ──────────────
# Supabase → Connect → "Session pooler" for the PROD project, + prod DB password.
DATABASE_URL=
SUPABASE_URL=
# PROD service-role key — server-side ONLY. Never NEXT_PUBLIC_/VITE_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Production origin of apps/web (for CORS / redirects), e.g. https://app.<domain>.
FRONTEND_URL=
PORT=4000
NODE_ENV=production
FOOTBALL_DATA_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Shared secret guarding POST /internal/jobs/:type self-calls.
# Generate a fresh production value with: openssl rand -hex 32.
INTERNAL_JOB_SECRET=
ADMIN_USERNAME=
# Use a STRONG, prod-only password.
ADMIN_PASSWORD=
# FRESH secret for prod: openssl rand -hex 32  (do not reuse the dev secret).
ADMIN_SESSION_SECRET=
# Production URL of apps/web (invite redirect → ${APP_URL}/set-password).
APP_URL=
# Admin self-call base URL for internal job triggers.
API_BASE_URL=https://admin.85percent.pro/api
# Upstash Redis for distributed API rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ── apps/web  (Vite SPA — Vercel Production env; values bundled to browser) ──
# ANON key ONLY. The build inlines VITE_ vars, so anything here ships publicly.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# ── apps/landing-page  (Next.js marketing — Vercel Production env) ───────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=
# A DEDICATED prod Upstash database (separate quota/limits from dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
