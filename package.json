{
  "name": "85percent",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "data-sync:adapter:setup": "bash scripts/data-sync-adapter.sh setup",
    "data-sync:adapter:start": "bash scripts/data-sync-adapter.sh start",
    "data-sync:adapter:status": "bash scripts/data-sync-adapter.sh status",
    "data-sync:adapter:stop": "bash scripts/data-sync-adapter.sh stop",
    "data-sync:local": "bash scripts/data-sync-local.sh",
    "data-sync:local:dev": "bash scripts/data-sync-local.sh dev",
    "data-sync:local:prod": "bash scripts/data-sync-local.sh prod"
  },
  "devDependencies": {
    "turbo": "^2.5.3",
    "typescript": "^5.8.3",
    "@types/node": "^22.15.18",
    "prettier": "^3.5.3",
    "eslint": "^9.27.0"
  }
}
