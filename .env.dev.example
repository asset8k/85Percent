# ============================================================================
# 85Percent — DEVELOPMENT / STAGING environment template
# ----------------------------------------------------------------------------
# These are the keys for the DEV Supabase project:
#     Project ref : deebcfzsgdwnmeoqphgm
#     URL         : https://deebcfzsgdwnmeoqphgm.supabase.co
#     Region      : eu-central-1
#
# This monorepo does NOT load a single root .env. Each app reads its OWN env
# file with its OWN variable prefix. This template is the consolidated DEV
# reference: copy each section into the per-app file shown in its header and
# fill the blanks with the values from this DEV project.
#
#   apps/api/.env              apps/admin/.env
#   apps/web/.env.local        apps/landing-page/.env.local
#
# Put DEV keys here / in the dev files. PROD keys go in .env.prod.example and
# the production host (Vercel Production env / the api host). Never commit a
# filled-in copy — only this *.example with blank values is tracked.
# ============================================================================


# ── apps/api/.env  (Fastify API — server only) ──────────────────────────────
# Postgres connection (Supabase session pooler, port 5432). Grab the exact
# string from Supabase → Connect → "Session pooler", then add your DB password.
DATABASE_URL=
SUPABASE_URL=
# Service-role key (sb_secret_… / legacy service_role JWT). FULL DB + auth-admin
# access. Server-side ONLY — never NEXT_PUBLIC_/VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Anon / publishable key (sb_publishable_… / legacy anon JWT).
SUPABASE_ANON_KEY=
FRONTEND_URL=http://localhost:5173
PORT=3001
NODE_ENV=development
# Optional integrations.
FOOTBALL_DATA_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Shared secret guarding POST /internal/jobs/:type (admin → API job triggers).
# Must equal INTERNAL_JOB_SECRET in apps/admin. openssl rand -hex 32.
INTERNAL_JOB_SECRET=


# ── apps/admin/.env  (Next.js admin panel — server only) ────────────────────
# Reuses the SAME Supabase project + service-role key as apps/api.
# SUPABASE_URL=                (same value as above)
# SUPABASE_SERVICE_ROLE_KEY=   (same value as above)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Signs the admin session cookie. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
# Base URL of apps/web (invite redirect target → ${APP_URL}/set-password).
APP_URL=http://localhost:5173
# Fastify API base URL — admin POSTs job triggers here. Dev = local API server.
API_BASE_URL=http://localhost:3001
# MUST equal the api's INTERNAL_JOB_SECRET above (same value on both sides).
INTERNAL_JOB_SECRET=


# ── apps/web/.env.local  (Vite SPA — shipped to the browser) ────────────────
# Vite only exposes VITE_-prefixed vars to client code. ANON key ONLY here —
# never a service-role key (it would be bundled into the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# ── apps/landing-page/.env.local  (Next.js marketing site) ──────────────────
# Public URL is exposed to the browser; the anon key is read server-side in the
# lead-capture route (insert-only into demo_requests).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=
# Upstash Redis (serverless REST) — per-IP rate limit on the lead form.
# Use a SEPARATE Upstash database for dev vs prod. https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
