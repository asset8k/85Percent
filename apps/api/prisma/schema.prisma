// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Club {
  id        String   @id @default(uuid())
  name      String
  shortName String   @map("short_name")
  leagueId  String   @map("league_id")
  logoUrl   String?  @map("logo_url") // crest URL adopted from the onboarding template
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users      User[]
  financials ClubFinancials[]
  players    Player[]
  contracts  Contract[]
  managers          Manager[]
  managerContracts  ManagerContract[]
  scenarios  Scenario[]
  auditLogs  AuditLog[]
  ssrWorkingCapital SsrWorkingCapital[]
  ssrLiquidity      SsrLiquidity[]
  ssrEquity         SsrEquity[]
  invites           Invite[]

  @@map("clubs")
}

model User {
  id        String   @id // Matches Supabase auth.users id
  clubId    String   @map("club_id")
  role      String   // 'cfo' | 'sporting_director' | 'finance_analyst' | 'admin'
  fullName  String   @map("full_name")
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  club      Club       @relation(fields: [clubId], references: [id])
  scenarios Scenario[]
  auditLogs AuditLog[]

  @@map("users")
}

model ClubFinancials {
  id                     String    @id @default(uuid())
  clubId                 String    @map("club_id")
  season                 String    // '2026-27'
  // All monetary values stored as BigInt in pence — NEVER float
  // current_squad_costs REMOVED — now derived from contracts (Phase 2 sum)
  footballRelatedRevenue BigInt    @map("football_related_revenue")
  // 'derived' (sum from active contracts) or 'manual' (user-entered override).
  // Default 'derived' preserves MVP 2.0 behavior. When 'manual',
  // manualSquadCosts is used everywhere currentSquadCosts is read.
  squadCostsMode         String    @default("derived") @map("squad_costs_mode")
  manualSquadCosts       BigInt?   @map("manual_squad_costs")
  currentAllowanceRatio  Decimal   @map("current_allowance_ratio")
  ownerEquityUsed1yr     BigInt?   @map("owner_equity_used_1yr")  // Championship only
  ownerEquityUsed3yr     BigInt?   @map("owner_equity_used_3yr")  // Championship only
  seasonStartDate        DateTime? @map("season_start_date")      // drives book-value amortisation
  seasonEndDate          DateTime? @map("season_end_date")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  club Club @relation(fields: [clubId], references: [id])

  @@unique([clubId, season])
  @@map("club_financials")
}

model Player {
  id          String    @id @default(uuid())
  clubId      String    @map("club_id")
  name        String
  position    String?   // 'GK' | 'DEF' | 'MID' | 'FWD'
  squadNumber Int?      @map("squad_number") // shirt number (1–99); null = unassigned
  nationality String?
  dateOfBirth DateTime? @map("date_of_birth")
  // Original date the player joined the club, kept even when the current
  // contract start is a later extension date. Display / tenure context only.
  joinedDate  DateTime? @map("joined_date")
  isActive    Boolean   @default(true) @map("is_active")   // false = archived (departed)
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  club            Club             @relation(fields: [clubId], references: [id])
  contracts       Contract[]
  scenarioActions ScenarioAction[]

  @@index([clubId, isActive])
  @@map("players")
}

model Contract {
  id                  String   @id @default(uuid())
  playerId            String   @map("player_id")
  clubId              String   @map("club_id")
  // All monetary values in pence
  transferFee         BigInt   @map("transfer_fee")
  annualWage          BigInt   @map("annual_wage")
  agentFee            BigInt   @map("agent_fee")
  startDate           DateTime @map("start_date")
  endDate             DateTime @map("end_date")
  contractLengthYears Decimal  @map("contract_length_years") // computed at insert from dates
  bookValue           BigInt   @map("book_value")            // amortised remaining value, pence
  // Carried Book Value override (pence). Set when a player signed an extension
  // mid-tenure and we lack the historical contract phases to amortise the
  // original fee from scratch (e.g. Transfermarkt snapshots). When non-null the
  // engine IGNORES transferFee and amortises this exact remaining NBV over the
  // phase length (capped at 5 years from start). Null = standard fee amortisation.
  carriedBookValue    BigInt?  @map("carried_book_value")
  isActive            Boolean  @default(true) @map("is_active")
  // Contract ledger (multi-phase history). `phaseType` distinguishes the
  // original signing from later extensions. `isCurrent` marks the single live
  // phase for the player (a partial unique index enforces one-per-player).
  // `supersededAt` is set on the old phase when an extension replaces it.
  phaseType           String    @default("INITIAL") @map("phase_type") // 'INITIAL' | 'EXTENSION'
  isCurrent           Boolean   @default(true) @map("is_current")
  supersededAt        DateTime? @map("superseded_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [id])
  club   Club   @relation(fields: [clubId], references: [id])

  @@index([clubId, isActive])
  @@index([playerId, isActive])
  @@index([playerId, isCurrent])
  @@map("contracts")
}

// Head Coach / Manager. Their wages, compensation fee, and agent fees count
// toward the club's Squad Cost Ratio. A club has at most one active manager.
model Manager {
  id          String   @id @default(uuid())
  clubId      String   @map("club_id")
  name        String
  nationality String?  // parsed from the template Coaching Staff page; nullable
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  club      Club              @relation(fields: [clubId], references: [id])
  contracts ManagerContract[]

  @@index([clubId, isActive])
  @@map("managers")
}

// Mirror of Contract for managers. The capitalised fee is a "compensation fee"
// (paid to release them from a previous club) rather than a transfer fee.
// Same multi-phase ledger semantics as Contract.
model ManagerContract {
  id                  String    @id @default(uuid())
  managerId           String    @map("manager_id")
  clubId              String    @map("club_id")
  compensationFee     BigInt    @map("compensation_fee")
  annualWage          BigInt    @map("annual_wage")
  agentFee            BigInt    @map("agent_fee")
  startDate           DateTime  @map("start_date")
  endDate             DateTime  @map("end_date")
  contractLengthYears Decimal   @map("contract_length_years")
  bookValue           BigInt    @map("book_value")
  phaseType           String    @default("INITIAL") @map("phase_type") // 'INITIAL' | 'EXTENSION'
  isCurrent           Boolean   @default(true) @map("is_current")
  supersededAt        DateTime? @map("superseded_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  manager Manager @relation(fields: [managerId], references: [id])
  club    Club    @relation(fields: [clubId], references: [id])

  @@index([clubId])
  @@index([managerId, isCurrent])
  @@map("manager_contracts")
}

// Named multi-action scenario — replaces flat simulations table
model Scenario {
  id         String   @id @default(uuid())
  clubId     String   @map("club_id")
  createdBy  String   @map("created_by")
  season     String
  name       String   // "January Plan A"
  isIncluded Boolean  @default(false) @map("is_included") // part of Active Baseline
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  club    Club             @relation(fields: [clubId], references: [id])
  user    User             @relation(fields: [createdBy], references: [id])
  actions ScenarioAction[]

  @@index([clubId, season])
  @@map("scenarios")
}

// One row per action within a scenario (buy / sell / loan_in / loan_out / release)
model ScenarioAction {
  id         String   @id @default(uuid())
  scenarioId String   @map("scenario_id")
  actionType String   @map("action_type") // 'buy' | 'sell' | 'loan_in' | 'loan_out' | 'release'
  payload    Json     // delta input (same shape as TransferInput)
  playerId   String?  @map("player_id")   // FK for sell / release / loan_out of existing player
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")

  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  player   Player?  @relation(fields: [playerId], references: [id])

  @@index([scenarioId, orderIndex])
  @@map("scenario_actions")
}

// Premier League SSR — Working Capital (one row per club/season/month)
model SsrWorkingCapital {
  id                  String   @id @default(uuid())
  clubId              String   @map("club_id")
  season              String
  yearMonth           String   @map("year_month") // '2026-07' through '2027-06'
  adjustedCashflow    BigInt   @map("adjusted_cashflow") // pence
  qualifyingFunds     BigInt   @map("qualifying_funds")  // pence
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  club Club @relation(fields: [clubId], references: [id])

  @@unique([clubId, season, yearMonth])
  @@map("ssr_working_capital")
}

// Premier League SSR — Liquidity (one row per club/season)
model SsrLiquidity {
  id                   String   @id @default(uuid())
  clubId               String   @map("club_id")
  season               String
  liquidAssets         BigInt   @map("liquid_assets")        // pence
  liquidLiabilities    BigInt   @map("liquid_liabilities")   // pence
  squadMarketValue     BigInt   @map("squad_market_value")   // pence
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  club Club @relation(fields: [clubId], references: [id])

  @@unique([clubId, season])
  @@map("ssr_liquidity")
}

// Premier League SSR — Positive Equity (one row per club/season)
model SsrEquity {
  id                  String   @id @default(uuid())
  clubId              String   @map("club_id")
  season              String
  totalLiabilities    BigInt   @map("total_liabilities") // pence
  adjustedAssets      BigInt   @map("adjusted_assets")   // pence
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  club Club @relation(fields: [clubId], references: [id])

  @@unique([clubId, season])
  @@map("ssr_equity")
}

// Pending invitations to join a club. Token expires after 7 days.
// On accept (full OTP signup), the row is marked accepted and the
// new public.users row inherits the invite's club_id + role.
model Invite {
  id         String    @id @default(uuid())
  clubId     String    @map("club_id")
  email      String
  role       String    // 'cfo' | 'sporting_director' | 'finance_analyst'
  invitedBy  String    @map("invited_by")
  token      String    @unique
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  club Club @relation(fields: [clubId], references: [id])

  @@index([email, acceptedAt])
  @@map("invites")
}

// ── Template roster dictionary (MVP 2.0 onboarding) ─────────────────────────
// These tables are a STATIC, club-agnostic dictionary scraped on a controlled
// monthly background schedule from the felipeall/transfermarkt-api. They sit
// completely separate from the live multi-tenant tables above — nothing here
// is club_id-scoped or RLS-isolated, because the data is the same for everyone
// and is only read during onboarding to pre-fill a tenant's starting roster.

enum TemplateLeague {
  PREMIER_LEAGUE
  CHAMPIONSHIP
}

// A manager carries no playing position, hence position is nullable on the
// roster item — these are the only valid values for players.
enum TemplatePosition {
  GK
  DEF
  MID
  FWD
}

model TemplateClub {
  id        String         @id @default(uuid())
  name      String         @unique // e.g. "Chelsea FC"
  league    TemplateLeague
  logoUrl   String?        @map("logo_url")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  rosterItems TemplateRosterItem[]

  @@map("template_clubs")
}

model TemplateRosterItem {
  id                   String            @id @default(uuid())
  templateClubId       String            @map("template_club_id")
  name                 String
  dateOfBirth          DateTime?         @map("date_of_birth")
  nationality          String?
  // Null for managers (isManager = true); set to a playing position otherwise.
  position             TemplatePosition?
  // Shirt number (1–99) scraped from the player's Transfermarkt profile; null
  // when unknown or for managers.
  squadNumber          Int?              @map("squad_number")
  isManager            Boolean           @default(false) @map("is_manager")
  // Historical purchase price in integer pence (GBP) — the ACTUAL fee paid for a
  // player's current move (or a manager's compensation fee), NOT speculative
  // market value. 0 for academy graduates / free agents; seeds the initial
  // transfer fee + book value on hydration.
  estimatedTransferFee BigInt?           @map("estimated_transfer_fee")
  contractStart        DateTime?         @map("contract_start")
  contractEnd          DateTime?         @map("contract_end")
  // Original join date, preserved separately from contractStart (which may be an
  // extension date). Carried through to players.joinedDate on hydration.
  joinedDate           DateTime?         @map("joined_date")
  // True when contractStart was derived from a last_extension date — i.e. this
  // is the back end of an existing deal, not the original signing. Hydration
  // marks the live contract as an EXTENSION phase so the UI prompts the CFO to
  // record the carried book value (the original fee is unknown).
  contractStartFromExtension Boolean     @default(false) @map("contract_start_from_extension")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  templateClub TemplateClub @relation(fields: [templateClubId], references: [id], onDelete: Cascade)

  @@index([templateClubId])
  @@map("template_roster_items")
}

// Append-only audit log — never delete rows
model AuditLog {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  clubId        String   @map("club_id")
  tableName     String   @map("table_name")
  recordId      String   @map("record_id")
  action        String   // 'create' | 'update' | 'delete'
  previousValue Json?    @map("previous_value")
  newValue      Json?    @map("new_value")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  club Club @relation(fields: [clubId], references: [id])

  @@map("audit_logs")
}
