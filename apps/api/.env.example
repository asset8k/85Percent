DATABASE_URL=postgresql://postgres:password@localhost:5432/headroom
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
FRONTEND_URL=http://localhost:5173
PORT=3001
NODE_ENV=development
# Optional — football-data.org API key for live league standings (Consequence
# Engine). When unset, /league-table serves a bundled end-of-season snapshot.
FOOTBALL_DATA_API_KEY=

# Required for the Expert Co-pilot (AI) feature — Anthropic API key for Claude
# inference. Server-side only; never exposed to the browser. The /chat route
# returns a clear error until this is set.
ANTHROPIC_API_KEY=
# Optional — override the Claude model used by the Co-pilot (default below).
ANTHROPIC_MODEL=claude-sonnet-4-6

# Shared secret guarding POST /internal/jobs/:type, which the admin panel calls
# to trigger the maintenance scripts. Must match INTERNAL_JOB_SECRET in
# apps/admin/.env. Generate with `openssl rand -hex 32`. Unset = the job
# endpoint refuses every request (fails closed).
INTERNAL_JOB_SECRET=
