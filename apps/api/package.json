{
  "name": "@headroom/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "sync:templates": "tsx --env-file=.env src/scripts/sync-templates.ts",
    "test:scripts": "node --import tsx --test src/scripts/transfermarkt-mappers.test.ts",
    "test:onboarding": "node --import tsx --env-file=.env --test src/routes/onboarding-hydrate.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.2.2",
    "@headroom/engine": "workspace:*",
    "@headroom/shared": "workspace:*",
    "@prisma/client": "^6.9.0",
    "@supabase/supabase-js": "^2.50.0",
    "@types/papaparse": "^5.5.2",
    "fastify": "^5.4.0",
    "papaparse": "^5.5.3",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "prisma": "^6.19.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
