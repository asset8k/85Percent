{
  "name": "@85percent/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "sync:templates": "tsx --env-file=.env src/scripts/sync-templates.ts",
    "update:league": "tsx --env-file=.env src/scripts/update-league-table.ts",
    "ingest:kb": "tsx --env-file=.env src/scripts/ingest-knowledge-base.ts",
    "test:scripts": "node --import tsx --test 'src/scripts/*.test.ts'",
    "test:onboarding": "node --import tsx --env-file=.env --test src/routes/onboarding-hydrate.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.0",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.2.2",
    "@85percent/engine": "workspace:*",
    "@85percent/shared": "workspace:*",
    "@prisma/client": "^6.9.0",
    "@supabase/supabase-js": "^2.50.0",
    "@types/papaparse": "^5.5.2",
    "@xenova/transformers": "^2.17.2",
    "ai": "^4.3.16",
    "fastify": "^5.4.0",
    "otplib": "^12.0.1",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "@types/qrcode": "^1.5.6",
    "prisma": "^6.19.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
