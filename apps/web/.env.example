# apps/web (Vite) client bundle env — anything prefixed VITE_ ships to the
# browser, so only the publishable/anon key belongs here, never a secret key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Reference credentials for both Supabase projects — same naming convention as
# apps/admin/.env.example — publishable keys only. Not read by any app code.
SUPABASE_DEV_URL=https://<dev-project-ref>.supabase.co
SUPABASE_DEV_PUBLISHABLE_KEY=

SUPABASE_PROD_URL=https://<prod-project-ref>.supabase.co
SUPABASE_PROD_PUBLISHABLE_KEY=
