{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter @85percent/web...",
  "buildCommand": "cd ../.. && node scripts/validate-vercel-env.mjs web && pnpm --filter @85percent/web... run build",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://admin.85percent.pro/api/:path*" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
