# Admin panel + serverless API configuration. Copy to apps/admin/.env and fill in.

PORT=4000
NODE_ENV=development

# Supabase — service-role key (full DB + auth-admin access).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Required by the public login/2FA proxy routes.
SUPABASE_ANON_KEY=
# Prisma CLI only; runtime database access uses Supabase.
DATABASE_URL=

# Single admin login (separate from the platform's user auth).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Random secret used to sign the session cookie (e.g. `openssl rand -hex 32`).
ADMIN_SESSION_SECRET=

# Base URL of this app's Route Handlers. This can be omitted: local defaults to
# port 4000 and Vercel derives its deployment URL automatically.
API_BASE_URL=http://localhost:4000/api

# Optional deployed-worker mode. Local admin imports use DATA_IMPORT_DISPATCH_MODE=local
# and do not call QStash. The signing keys protect the HTTPS QStash worker route.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Required only for QStash. Must be a public HTTPS endpoint; local mode does not
# use this callback.
DATA_IMPORT_CALLBACK_URL=
DATA_IMPORT_MAX_CLUBS_PER_RUN=10
DATA_IMPORT_MAX_CONCURRENT_TASKS=2
DATA_IMPORT_MAX_TASK_ATTEMPTS=3
DATA_IMPORT_REQUEST_TIMEOUT_MS=20000
DATA_IMPORT_RETRY_BASE_MS=1500

# Base URL of the main web app (apps/web). Used as the redirect target for
# account-provisioning invites: the invitee lands on `${APP_URL}/set-password`.
# Dev default is http://localhost:5173; set the real domain in production.
APP_URL=http://localhost:5173

# Distributed API rate limiting. Use the same rotated Upstash database as the
# landing app, configured separately in the admin Vercel project.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Compliance Analyst inference and optional model override.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Required for manually publishing live league standings. The public API's
# bundled fallback is never accepted as an admin import source.
FOOTBALL_DATA_API_KEY=

# Squad provider. Local-admin workflow uses the local Docker adapter.
# Do not enable QStash when this points to localhost.
TRANSFERMARKT_API_URL=http://localhost:8000
TRANSFERMARKT_WEB_URL=https://www.transfermarkt.com
DATA_IMPORT_DISPATCH_MODE=local
DATA_IMPORT_TARGETS=dev,prod
DATA_IMPORT_DEFAULT_TARGET=dev
DATA_IMPORT_TARGET_DEV_LABEL=Development
# The existing SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY above are the dev target.
DATA_IMPORT_TARGET_PROD_LABEL=Production
DATA_IMPORT_TARGET_PROD_IS_PRODUCTION=true
DATA_IMPORT_TARGET_PROD_SUPABASE_URL=
DATA_IMPORT_TARGET_PROD_SUPABASE_SERVICE_ROLE_KEY=
