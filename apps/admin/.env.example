# Admin panel configuration. Copy to apps/admin/.env and fill in.
# The Supabase values mirror apps/api/.env (same project, service-role key).

PORT=4000
NODE_ENV=development

# Supabase — service-role key (full DB + auth-admin access). SAME as apps/api/.env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Single admin login (separate from the platform's user auth).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Random secret used to sign the session cookie (e.g. `openssl rand -hex 32`).
ADMIN_SESSION_SECRET=

# Base URL of the Fastify API. The admin panel POSTs here to trigger the
# maintenance jobs (the API runs them in-process). Dev default below; in
# production set the deployed API origin, e.g. https://api.85percent.pro.
API_BASE_URL=http://localhost:3001
# Shared secret for the admin → API job-trigger call. MUST match
# INTERNAL_JOB_SECRET in apps/api/.env. Generate with `openssl rand -hex 32`.
INTERNAL_JOB_SECRET=

# Base URL of the main web app (apps/web). Used as the redirect target for
# account-provisioning invites: the invitee lands on `${APP_URL}/set-password`.
# Dev default is http://localhost:5173; set the real domain in production.
APP_URL=http://localhost:5173
