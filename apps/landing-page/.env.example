# Copy to .env.local and fill in. The landing page uses the Supabase ANON key
# only — it inserts leads into demo_requests and can do nothing else. Never put a
# service-role/secret key in NEXT_PUBLIC_SUPABASE_URL / SUPABASE_ANON_KEY below.
#
# These two are what the app actually reads at runtime (lib/supabase.ts) and
# select which Supabase project demo-request submissions land in. Use the DEV
# project locally; production (Vercel) must use the PROD project so real leads
# don't land in the dev database.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-or-publishable-key>

# PostHog browser analytics. This is a public ingestion token, not a service
# key. Set ENVIRONMENT to development for local localhost capture or production
# for the live production domain.
NEXT_PUBLIC_POSTHOG_KEY=phc_your-project-token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_ENVIRONMENT=development

# Upstash Redis (serverless REST) — per-IP rate limiting for the lead form.
# Create a database at https://console.upstash.com and copy the REST URL + token.
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<upstash-rest-token>

# Reference credentials for both Supabase projects — same naming convention as
# apps/admin/.env.example — so the right value is always at hand for manual
# testing against either target. Not read by any app code.
SUPABASE_DEV_URL=https://<dev-project-ref>.supabase.co
SUPABASE_DEV_PUBLISHABLE_KEY=
SUPABASE_DEV_SECRET_KEY=

SUPABASE_PROD_URL=https://<prod-project-ref>.supabase.co
SUPABASE_PROD_PUBLISHABLE_KEY=
SUPABASE_PROD_SECRET_KEY=
