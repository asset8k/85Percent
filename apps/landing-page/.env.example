# Copy to .env.local and fill in. The landing page uses the Supabase ANON key
# only — it inserts leads into demo_requests and can do nothing else. Never put a
# service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-or-publishable-key>

# Upstash Redis (serverless REST) — per-IP rate limiting for the lead form.
# Create a database at https://console.upstash.com and copy the REST URL + token.
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<upstash-rest-token>
